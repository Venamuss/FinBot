# Use a random URL-safe password (letters, digits, '-' and '_').
POSTGRES_PASSWORD=replace-with-random-local-password
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8080

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
# Optional for local endpoints; OpenRouter requires a key. Never commit a real key.
LLM_API_KEY=
LLM_TIMEOUT=30s

# Empty token disables polling; empty allowlist denies all bot users.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

TIME_ZONE=Europe/Moscow
