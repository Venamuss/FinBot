# Use a random URL-safe password (letters, digits, '-' and '_').
POSTGRES_PASSWORD=replace-with-random-local-password
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8080

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
# Optional for local endpoints; OpenRouter requires a key. Never commit a real key.
LLM_API_KEY=
LLM_TIMEOUT=30s

# Empty token disables polling; empty allowlist denies all bot users.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

TIME_ZONE=Europe/Moscow

# Optional outbound proxy for the Go service; leave unset for direct connectivity.
# Use addresses reachable from the app container; no host gateway is assumed.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,db

# Backend logging: DEBUG, INFO, WARN, ERROR (case-insensitive).
LOG_LEVEL=INFO
# Positive Go durations; HTTP request deadline must be below the 15s write limit.
HTTP_REQUEST_TIMEOUT=5s
# Shared database readiness and migration startup deadline.
STARTUP_TIMEOUT=30s
# Long poll uses whole seconds, 1s..50s; HTTP timeout must be greater.
TELEGRAM_POLL_TIMEOUT=25s
TELEGRAM_HTTP_TIMEOUT=40s
# API retries use this base delay, then twice the delay (at most 3 attempts).
TELEGRAM_RETRY_DELAY=1s
# Pause before retrying an unacknowledged update/poll after failure.
TELEGRAM_POLL_RETRY_DELAY=5s

# Direct Go process only: Compose supplies DATABASE_URL and fixes HTTP_ADDR
# to :8080 so nginx can reach it. URL-encode credentials in a direct DSN.
# DATABASE_URL=postgres://finbot:password@127.0.0.1:5432/finbot?sslmode=disable
# HTTP_ADDR=127.0.0.1:8080
# Frontend development only: export before npm run dev, or set in frontend/.env.local.
# Never use VITE_* for backend credentials.
# FINBOT_DEV_API_URL=http://127.0.0.1:8080
